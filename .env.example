#  Sevkur Mobilya — ortam ayarları
#
#  Bu dosya CANLI (üretim) kurulumu baz alır. Yerelde geliştirirken
#  APP_ENV=local, APP_DEBUG=true yapın ve MAIL_MAILER=log bırakın.
#
#  Canlıya çıkmadan önce: php artisan yayin:kontrol

APP_NAME="Sevkur Mobilya"
APP_ENV=production
APP_KEY=
# true kalırsa Laravel hata ekranında dosya yollarını, sorguları ve
# .env değerlerini MÜŞTERİYE gösterir. Canlıda her zaman false.
APP_DEBUG=false
APP_URL=https://sevkurmobilya.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
APP_TIMEZONE=Europe/Istanbul

LOG_CHANNEL=stack
LOG_LEVEL=error

#  Veritabanı — Turhost cPanel'de MySQL.
#  Yerelde SQLite ile çalışmak için DB_CONNECTION=sqlite yeter, diğer
#  DB_ satırları gereksizdir. SQLite'tan MySQL'e geçerken:
#    php artisan migrate --force
#    php artisan veri:tasi --kaynak=sqlite --hedef=mysql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sevkur
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
QUEUE_CONNECTION=database
CACHE_STORE=database

#  E-posta — "log" sipariş onayını MÜŞTERİYE GÖNDERMEZ, yalnızca
#  storage/logs/laravel.log dosyasına yazar. Canlıda smtp olmalı.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="info@sevkurmobilya.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

#  PayTR — mağaza panelinden alınır. PAYTR_TEST_MODE=1 iken gerçek
#  tahsilat YAPILMAZ; canlıda 0 olmalı.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=0
